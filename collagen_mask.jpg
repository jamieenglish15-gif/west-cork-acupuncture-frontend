":\"https://cdn.faire.com/fastly/2a34d868c21f89849a38b0cd7a066c73e9d6780d424a582630a5e04ce3840859.jpeg\",\"type\":\"PRODUCT\",\"optimized_url\":\"https://cdn.faire.com/fastly/2a34d868c21f89849a38b0cd7a066c73e9d6780d424a582630a5e04ce3840859.jpeg?format=jpg\u0026precrop=1:1\",\"tags\":[\"cloudinary_crop_fill\",\"Product\"],\"crop_parameters\":[]},{\"token\":\"i_3anbuxrg6g\",\"width\":2000,\"height\":2000,\"sequence\":3,\"url\":\"https://cdn.faire.com/fastly/5248bb01628846ad3b00492fd8232dc6bb57f11ef33f188377d395add3db91b4.jpeg\",\"type\":\"PRODUCT\",\"optimized_url\":\"https://cdn.faire.com/fastly/5248bb01628846ad3b00492fd8232dc6bb57f11ef33f188377d395add3db91b4.jpeg?format=jpg\u0026precrop=1:1\",\"tags\":[\"cloudinary_crop_fill\",\"Product\"],\"crop_parameters\":[]},{\"token\":\"i_yhqu9faasw\",\"width\":2000,\"height\":2000,\"sequence\":4,\"url\":\"https://cdn.faire.com/fastly/9b51004be8a109ac35500207144b57027a129c28f7e96b5689ebf77f38224a05.jpeg\",\"type\":\"PRODUCT\",\"optimized_url\":\"https://cdn.faire.com/fastly/9b51004be8a109ac35500207144b57027a129c28f7e96b5689ebf77f38224a05.jpeg?format=jpg\u0026precrop=1:1\",\"tags\":[\"cloudinary_crop_fill\",\"Product\",\"HIS_V5_FINE\"],\"crop_parameters\":[]}],\"videos\":[]},\"purchase_information\":{\"unit_multiplier\":1,\"min_order_quantity\":1,\"per_style_min_order_quantity\":0,\"product_orderability_counts\":{\"preorderable_options_count\":0,\"immediately_orderable_options_count\":1},\"variation_map\":{\"entries\":[]},\"maker_best_seller\":false,\"is_new\":false,\"allow_sales_when_out_of_stock\":false,\"import_shipment_info\":\"Import duties apply: Made in China, ships from United States.\",\"is_mid_price_point_brand_apparel_product\":false,\"max_option_retail_price\":{\"amount_cents\":2160,\"currency\":\"EUR\",\"original_amount_cents\":2500,\"original_currency\":\"USD\"},\"max_option_wholesale_price\":{\"amount_cents\":1080,\"currency\":\"EUR\",\"original_amount_cents\":1250,\"original_currency\":\"USD\"},\"has_pre_packs_available\":false,\"is_preorderable\":false,\"tester_prices\":[],\"style_groups\":{},\"customizations\":[],\"verified_external_prices_by_option_token\":{}},\"details\":{\"taxonomy_type\":{\"token\":\"tt_8motnmby1e\",\"name\":\"Skincare Face Mask\",\"group_name\":\"Face Masks\",\"clean_name\":\"Skincare Face Mask\",\"target_customer\":\"ALL_CUSTOMERS\",\"target_customer_display_name\":\"All Customers\"},\"description\":{\"translated\":\"Your shortcut to radiant, lifted skin from face to neck. The Berry Bounce Face \u0026 Neck Lift Collagen Mask Set is drenched in a potent blend of plant based collagen, hyaluronic acid, and TCM botanical-powered hydration, featuring tremella mushroom, chrysanthemum and goji berry. This intensive treatment deeply hydrates, plumps, and visibly firms while supporting the skin barrier for a smoother, more even-toned glow.\\n\\nDesigned to address two of the most delicate areas, each mask conforms comfortably to the skin, delivering targeted, plant-based collagen care where you need it most. Use it as a quick daytime boost or as an overnight renewal ritual. Wake up (or walk out) looking lifted, luminous, and refreshed.\\n\"},\"attribute_tags\":[],\"product_option_measurements\":{},\"product_information_section_groups\":[{\"max_preview_lines\":3,\"type\":\"PRODUCT_INFORMATION\",\"sections\":[{\"section_header_text\":\"About this product\",\"section_type\":\"DESCRIPTION\",\"type\":\"DESCRIPTION\",\"analytics_id\":\"grpaunggbyrmwkb39ftzedzzj\",\"entries\":[{\"text\":{\"translated\":\"Your shortcut to radiant, lifted skin from face to neck. The Berry Bounce Face \u0026 Neck Lift Collagen Mask Set is drenched in a potent blend of plant based collagen, hyaluronic acid, and TCM botanical-powered hydration, featuring tremella mushroom, chrysanthemum and goji berry. This intensive treatment deeply hydrates, plumps, and visibly firms while supporting the skin barrier for a smoother, more even-toned glow.\\n\\nDesigned to address two of the most delicate areas, each mask conforms comfortably to the skin, delivering targeted, plant-based collagen care where you need it most. Use it as a quick daytime boost or as an overnight renewal ritual. Wake up (or walk out) looking lifted, luminous, and refreshed.\\n\"}}],\"option_level_entries_by_option_token\":{},\"modal_information_sections\":[]}]},{\"max_preview_lines\":2,\"type\":\"DETAILS_SECTION\",\"sections\":[{\"section_header_text\":\"Details\",\"section_type\":\"DETAILS\",\"type\":\"DETAILS\",\"analytics_id\":\"nr26zdpqtk45rg9twxd2ukqdp\",\"entries\":[{\"text\":{\"translated\":\"• Made in China\"},\"attribute\":{\"name\":{\"translated\":\"Made in\"},\"value\":{\"translated\":\"China\"}}}],\"option_level_entries_by_option_token\":{\"po_hucmyf9uw8\":{\"entries\":[{\"text\":{\"translated\":\"• Weight: 56.13 g (1.98 oz)\"},\"attribute\":{\"name\":{\"translated\":\"Weight\"},\"value\":{\"translated\":\"56.13 g (1.98 oz)\"}}},{\"text\":{\"translated\":\"• SKU: FMLC02\"},\"attribute\":{\"name\":{\"translated\":\"SKU\"},\"value\":{\"translated\":\"FMLC02\"}}},{\"text\":{\"translated\":\"• UPC: 850074500087\"},\"attribute\":{\"name\":{\"translated\":\"UPC\"},\"value\":{\"translated\":\"850074500087\"}}}]}},\"modal_information_sections\":[]}]}]},\"messages\":{\"info_texts\":[{\"icon_url\":\"https://cdn.faire.com/fastly/f604d38a8a6a007e25c92194dc06396f6810e47815f588f1a16592ef4f7d1e7f.png\",\"text\":\"Import duties apply: Made in China, ships from United States.\",\"text_color\":\"333333\",\"style\":\"REGULAR\",\"type\":\"SHIPS_FROM\",\"position\":\"BOTTOM\"},{\"icon_url\":\"https://cdn.faire.com/fastly/79c4227b071a4f1b1efb98995bbe5eb44abe88f9cc7a6a7091adac348a11cbaa.png\",\"text\":\"Eligible for \u003cb\u003efree returns\u003c/b\u003e\",\"text_color\":\"333333\",\"tooltip\":\"We offer free returns on every first order with a new brand.\",\"style\":\"REGULAR\",\"type\":\"FREE_RETURNS_ON_FIRST_ORDER\",\"position\":\"BOTTOM\"}],\"disclaimers\":[]},\"shipping_information\":{\"ha